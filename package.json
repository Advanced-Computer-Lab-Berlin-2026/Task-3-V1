    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev --workspace server\" \"npm:dev --workspace client\""
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "nodemon@1.19.4": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "autoprefixer": "^10.6.1"
  }
}
